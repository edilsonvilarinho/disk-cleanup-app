{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Cleanup",
  "version": "0.1.0",
  "identifier": "dev.diskcleanup.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disk Cleanup",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3ODc0MTRGMTFBOTQ0ODIKUldTQ1JLa1JUMEdIaDZlbGJPTXFEMjRVQ25Ma09tZ1RxZjN2SHBHZzJ1T2ppMnpOQXBUL1dCbEoK",
      "endpoints": [
        "https://github.com/edilsonvilarinho/disk-cleanup-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
